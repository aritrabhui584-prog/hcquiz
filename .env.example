# Firebase Client & Server Configuration (Replace with your Firebase Project credentials)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_OAUTH_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"

# Node / Backend Aliases
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
FIREBASE_DATABASE_ID="(default)"
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="000000000000"
FIREBASE_OAUTH_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# GOOGLE_SHEETS_SPREADSHEET_ID: Optional Google Spreadsheet ID for submission exports.
GOOGLE_SHEETS_SPREADSHEET_ID=""

# GOOGLE_SHEETS_WEBHOOK_URL: Webhook URL (Google Apps Script) to append participant & script rows.
GOOGLE_SHEETS_WEBHOOK_URL=""
